# Neon Postgres and Neon Auth (server-side credentials only)
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth
